{
  "name": "skill-fab-unreal-publishing",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Skill for preparing and reviewing Unreal Engine plugin listings for Fab",
  "license": "MIT",
  "homepage": "https://github.com/metyatech/skill-fab-unreal-publishing",
  "repository": {
    "type": "git",
    "url": "https://github.com/metyatech/skill-fab-unreal-publishing.git"
  },
  "bugs": {
    "url": "https://github.com/metyatech/skill-fab-unreal-publishing/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "markdownlint **/*.md --ignore node_modules",
    "format:check": "prettier --check .",
    "validate:skill": "node scripts/validate-skill.mjs",
    "verify": "npm run format:check && npm run lint && npm run validate:skill && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "compose-agentsmd": "^7.0.1",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.8.1",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "markdownlint-cli": {
      "js-yaml": "5.4.2"
    }
  }
}
